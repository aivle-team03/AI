REDIS_URL="redis://localhost:6379/0"

# Vertex AI Veo (동영상 생성)
GCP_PROJECT_ID="실제 GCP 프로젝트 ID"
GCP_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
VEO_MODEL_NAME="veo-3.1-lite-generate-001"

# Gemini (문서 분석 / 스토리보드 / 품질 검수)
GEMINI_API_KEY="실제 Gemini API 키"

# Cloudinary (생성 영상 호스팅)
CLOUDINARY_URL="cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>"

# 산출물 경로 (기본값 사용 시 생략 가능)
OUTPUT_DIR="output/videos"
UPLOAD_DIR="output/uploads"

BACKEND_API_URL="http://127.0.0.1:8000"
